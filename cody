  },
  {
    keywords: ["won't start","wont start","doesn't start","doesnt start","not starting","dead","no start","cranks","crank"],
    issue: 'Starting Failure — Battery / Starter',
    urgency: 'medium',
    cost: '$100 – $600',
    component: 'Battery / Starter Motor / Alternator',
    explanation: 'If the engine cranks slowly or not at all, the most common culprits are a weak battery, loose battery terminals, a failing starter motor, or a bad alternator that didn\'t charge the battery. A click-click with no crank typically points to the battery or connections.',
    advice: '💡 Try jump-starting. If it starts, get the battery & alternator tested right away.'
  },
  {
    keywords: ['vibration','shaking','vibrate','shake','steering wheel'],
    issue: 'Wheel Balance / Suspension Issue',
    urgency: 'low',
    cost: '$50 – $300',
    component: 'Wheels / Suspension / Tires',
    explanation: 'Vibration felt through the steering wheel or seat often indicates unbalanced wheels, a bent rim, worn tie rods, or failing CV axles. Vibration at specific speeds typically points to wheel balance, while constant shaking may indicate worn suspension components.',
    advice: '💡 Generally safe to drive short-term. Schedule a wheel balance and alignment check.'
  },
  {
    keywords: ['smoke','burning','smell','odor','fumes'],
    issue: 'Oil / Fluid Burn or Leak',
    urgency: 'high',
    cost: '$100 – $800+',
    component: 'Engine Seals / Gaskets',
    explanation: 'A burning smell or visible smoke (blue = oil burning; white = coolant/head gasket; grey = transmission fluid) indicates a fluid leak onto hot engine components. This can signal worn valve seals, a blown head gasket, or a transmission fluid leak.',
    advice: '🚨 Check fluid levels. If smoke is heavy, stop driving and seek help immediately.'
  },
  {
    keywords: ['stall','stalling','stalls','dies','cutting out','rough idle'],
    issue: 'Engine Stalling / Rough Idle',
    urgency: 'medium',
    cost: '$80 – $500',
    component: 'Fuel / Ignition / Sensors',
    explanation: 'Stalling or rough idling is usually caused by a dirty throttle body, a faulty idle air control valve, a bad mass airflow (MAF) sensor, clogged fuel injectors, or spark plug issues. The engine doesn\'t receive the right air/fuel mixture to run smoothly.',
    advice: '💡 Get an OBD scan and fuel system inspection soon. Car may not be reliable for long trips.'
  },
  {
    keywords: ['flat','tyre','tire','puncture','pressure','deflate'],
    issue: 'Tyre Pressure / Puncture',
    urgency: 'high',
    cost: '$20 – $200',
    component: 'Tyre / Wheel',
    explanation: 'Low tyre pressure or a puncture causes poor handling, increased fuel consumption, and risk of a blowout. TPMS warning lights indicate pressure is 25%+ below recommended. Even a slow puncture can rapidly deteriorate at highway speeds.',
    advice: '🚨 Pull over safely if handling is affected. Check tyre pressure or inspect for nails/damage.'
  }
];

const fallbackResult = {
  issue: 'General Mechanical Issue',
  urgency: 'medium',
  cost: '$50 – $500 (varies)',
  component: 'Various Systems',
  explanation: 'Based on your description, this could relate to several different systems. We recommend getting a free OBD-II diagnostic scan at your local auto parts store for specific fault codes, and describing your symptoms in more detail for a more precise diagnosis.',
  advice: '💡 Document when and how the issue occurs and consult a trusted mechanic.'
};

const quickDiagnosisMap = {
  'check-engine': diagnosisDB[3],
  'brake-noise':  diagnosisDB[1],
  'overheating':  diagnosisDB[4],
  'wont-start':   diagnosisDB[5]
};

function matchDiagnosis(text) {
  const lower = text.toLowerCase();
  let bestMatch = null, bestScore = 0;
  for (const entry of diagnosisDB) {
    const score = entry.keywords.filter(k => lower.includes(k)).length;
    if (score > bestScore) { bestScore = score; bestMatch = entry; }
  }
  return bestScore > 0 ? bestMatch : null;
}

function showResult(data) {
  document.getElementById('result-issue').textContent = data.issue;
  document.getElementById('result-cost').textContent = data.cost;
  document.getElementById('result-component').textContent = data.component;
  document.getElementById('result-explanation').textContent = data.explanation;
  document.getElementById('result-advice').textContent = data.advice;

  const badge = document.getElementById('result-urgency');
  badge.textContent = data.urgency.charAt(0).toUpperCase() + data.urgency.slice(1) + ' Urgency';
  badge.className = 'urgency-badge urgency-' + data.urgency;

  const card = document.getElementById('result-card');
  card.style.borderLeftColor = data.urgency === 'high' ? '#ef4444' : data.urgency === 'medium' ? '#f97316' : '#22c55e';

  const section = document.getElementById('result-section');
  section.classList.add('visible');
  setTimeout(() => section.scrollIntoView({ behavior: 'smooth', block: 'nearest' }), 100);
}

function diagnose() {
  const input = document.getElementById('symptom-input').value.trim();
  const noise = document.getElementById('noise-type').value;
  const when  = document.getElementById('when-happens').value;

  if (!input && !noise && !when) {
    document.getElementById('symptom-input').focus();
    document.getElementById('symptom-input').style.borderColor = '#ef4444';
    setTimeout(() => document.getElementById('symptom-input').style.borderColor = '', 1500);
    return;
  }

  // Loading state
  const btn = document.getElementById('diag-btn');
  const btnText = document.getElementById('btn-text');
  btn.disabled = true;
  btnText.innerHTML = '<span class="loader"></span> Analysing…';

  setTimeout(() => {
    const combined = `${input} ${noise} ${when}`;
    const result = matchDiagnosis(combined) || fallbackResult;
    showResult(result);
    btn.disabled = false;
    btnText.textContent = '🔍 Diagnose Problem';
  }, 900);
}

function quickDiagnose(key) {
  const data = quickDiagnosisMap[key];
  if (!data) return;
  document.getElementById('hero').scrollIntoView({ behavior: 'smooth' });
  setTimeout(() => showResult(data), 400);
}

// Allow Enter key in textarea (Shift+Enter = newline)
document.getElementById('symptom-input').addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); diagnose(); }
});

// ─── SCROLL ANIMATIONS ────────────────────────────────────────────────────
const observer = new IntersectionObserver((entries) => {
  entries.forEach((e, i) => {
    if (e.isIntersecting) {
      setTimeout(() => e.target.classList.add('in-view'), i * 80);
    }
  });
}, { threshold: 0.1 });
document.querySelectorAll('.fade-up').forEach(el => observer.observe(el));
</script>
</body>
</html>
